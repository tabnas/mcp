{
  "$schema": "ts/node_modules/wrangler/config-schema.json",
  "name": "tabnas-mcp",
  "main": "ts/src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "limits": { "cpu_ms": 200 },
  "ratelimits": [
    { "name": "MCP_LIMIT", "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [{ "pattern": "mcp.tabnas.dev", "custom_domain": true }]
}
