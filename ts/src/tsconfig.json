{
  "compilerOptions": {
    // The precompiled Ajv validator (tools/build-validator.js) is
    // generated JavaScript in src/; allowJs is what carries it into
    // dist/ alongside the compiled TypeScript. checkJs stays off: it is
    // machine-generated and not ours to type-check.
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "module": "nodenext",
    "noEmitOnError": true,
    "outDir": "../dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "useDefineForClassFields": false,
    "declaration": true,
    "declarationDir": "../dist",
    "types": ["node"]
  }
}
